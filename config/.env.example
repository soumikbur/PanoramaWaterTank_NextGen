# ==============================================================================
# Panorama Water Tank Monitor — Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENV=development
DEBUG=true
APP_NAME="Panorama Water Tank Monitor"
APP_VERSION="2.0.0"

# Security & Authentication
SECRET_KEY=replace_with_a_secure_random_64_char_key_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=panorama_app
POSTGRES_PASSWORD=panorama_secure_pass_2026
POSTGRES_DB=panorama_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://panorama_app:panorama_secure_pass_2026@localhost:5432/panorama_db
DATABASE_SYNC_URL=postgresql://panorama_app:panorama_secure_pass_2026@localhost:5432/panorama_db

# MQTT Broker Configuration (Mosquitto / HiveMQ)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TLS_PORT=8883
MQTT_USE_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=panorama-backend
MQTT_TELEMETRY_TOPIC_FILTER=panorama/telemetry/+
MQTT_COMMAND_TOPIC_PREFIX=panorama/commands/
MQTT_STATUS_TOPIC_FILTER=panorama/status/+

# Fallback Default Monitored Device
DEFAULT_DEVICE_UID=0026004D4B42501120353332
DEFAULT_TRAIN_NUMBER=12002
DEFAULT_COACH_NUMBER=B4

# Physical Tank Geometry Defaults
DEFAULT_TANK_CAPACITY_LITERS=20.0
DEFAULT_TANK_HEIGHT_CM=50.0
DEFAULT_TANK_AREA_M2=0.04
DEFAULT_WARNING_THRESHOLD=20.0
DEFAULT_CRITICAL_THRESHOLD=10.0
DEFAULT_OVERFLOW_THRESHOLD=100.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:8000","*"]

