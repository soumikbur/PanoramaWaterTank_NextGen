{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-mingw-debug",
      "displayName": "Windows MinGW 64-bit Debug",
      "description": "Configure build with Qt 6.12.0 MinGW 64-bit",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.12.0/mingw_64",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe"
      }
    },
    {
      "name": "windows-mingw-release",
      "displayName": "Windows MinGW 64-bit Release",
      "description": "Configure optimized release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.12.0/mingw_64",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "windows-mingw-debug"
    },
    {
      "name": "release",
      "configurePreset": "windows-mingw-release"
    }
  ],
  "testPresets": [
    {
      "name": "all-tests",
      "configurePreset": "windows-mingw-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

