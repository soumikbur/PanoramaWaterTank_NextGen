# =====================================================================
# PANORAMA WATER TANK MONITOR — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to backend/.env and replace placeholders with your values.
# DO NOT COMMIT REAL SECRETS OR PRODUCTION PASSWORDS TO VERSION CONTROL.
# =====================================================================

# Runtime Environment
ENV=development
DEBUG=true
APP_NAME="Panorama Water Tank Monitor"
APP_VERSION="2.0.0"

# Security & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM_KEY_AT_LEAST_32_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Local SQLite Development (WAL Mode enabled):
DATABASE_URL=sqlite+aiosqlite:///./panorama_dev.db
# Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://scada_user:CHANGE_ME_PASSWORD@localhost:5432/panorama_scada

# MQTT Message Broker
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_TLS_PORT=8883
MQTT_USE_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID_PREFIX=panorama-backend
MQTT_TELEMETRY_TOPIC_FILTER=panorama/telemetry/+
MQTT_COMMAND_TOPIC_PREFIX=panorama/commands/
MQTT_STATUS_TOPIC_FILTER=panorama/status/+

# Default Fleet Demonstration Parameters
DEFAULT_DEVICE_UID=0023004D4B42501120353332
DEFAULT_TRAIN_NUMBER=225256
DEFAULT_COACH_NUMBER=B4

# Physical Tank Geometry Defaults (Cylindrical Vessel)
DEFAULT_TANK_CAPACITY_LITERS=20.0
DEFAULT_TANK_HEIGHT_CM=50.0
DEFAULT_TANK_AREA_M2=0.04

# SCADA Alarm Thresholds (%)
DEFAULT_WARNING_THRESHOLD=20.0
DEFAULT_CRITICAL_THRESHOLD=10.0
DEFAULT_OVERFLOW_THRESHOLD=100.0

# CORS Allowed Origins (Comma-separated list in JSON format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:8000","http://127.0.0.1:3001","https://soumikbur.github.io"]
