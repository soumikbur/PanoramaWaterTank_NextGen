# Panorama Water Tank Monitor NextGen — Environment Configuration Template
# Copy this file to .env.local to configure local or deployment-specific overrides.

# ==============================================================================
# Google Maps JavaScript API Configuration
# ==============================================================================
# 1. Create a project in Google Cloud Console: https://console.cloud.google.com/
# 2. Enable the "Maps JavaScript API" in APIs & Services.
# 3. Create an API Key in Credentials, link billing, and set HTTP referrer restrictions.
# 4. Set the key below:
VITE_GOOGLE_MAPS_API_KEY=

# ==============================================================================
# Backend REST and WebSocket Service Endpoints
# ==============================================================================
VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_WS_URL=ws://127.0.0.1:8000/ws
