# Panorama Water Tank — HTTPS Receiver Environment Configuration
# Template file with placeholder values only. Do NOT put production secrets here.

# Environment mode: 'development' or 'production'
ENVIRONMENT=development

# Authentication Token (Set to a strong secret in production via Render environment settings)
API_TOKEN=dev_secret_token_123

# Operational logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Ingestion Constraints
MAX_UPLOAD_SIZE=1048576
MAX_HISTORY_RECORDS=1000

# Network and Port Configuration
HOST=127.0.0.1
PORT=8000
HTTP_PORT=8000
HTTPS_PORT=8443
HTTPS_ENABLED=false

# CORS Allowed Origins (Comma-separated or JSON list; defaults to GitHub Pages and localhost)
# CORS_ORIGINS=https://soumikbur.github.io,http://localhost:8000

# Local Development TLS Certificate Settings (ignored in production)
TLS_CERT_FILE=certificates/development/server.crt
TLS_KEY_FILE=certificates/development/server.key
