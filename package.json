{
  "name": "panoramawatertank-nextgen",
  "version": "2.0.0",
  "private": true,
  "description": "Panorama Water Tank Monitor — Railway SCADA/HMI Web Application",
  "engines": {
    "node": ">=20.0.0 <=24.x"
  },
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/mobile && node scripts/sync_dist.js",
    "dev": "npm run dev --workspace=apps/mobile",
    "start": "npm run start --workspace=apps/mobile",
    "preview": "npm run preview --workspace=apps/mobile",
    "audit:browser": "node tools/browser_audit/index.cjs",
    "audit:browser:headed": "node tools/browser_audit/index.cjs --headed",
    "audit:browser:local": "node tools/browser_audit/index.cjs --url http://127.0.0.1:8000"
  },
  "dependencies": {
    "esbuild": "^0.21.5",
    "playwright": "^1.65.1"
  }
}
